# Variables d'environnement — copier ce fichier vers .env et ajuster
#   cp .env.example .env

# URL de l'API backend (utilisé par le code source via import.meta.env.VITE_API_URL)
# En développement : http://localhost:8080 (ou tunnel ngrok)
# En test : doit être vide (les appels sont interceptés par cy.intercept())
VITE_API_URL=

# Cible du proxy Vite (dev server uniquement)
# Les requêtes /auth, /users, /companies, etc. sont proxyfiées vers cette URL
VITE_PROXY_TARGET=http://localhost:8080

# Hosts autorisés par le dev server Vite (ex: tunnels ngrok)
# Séparer plusieurs hosts par des virgules si nécessaire
VITE_NGROK_HOST=
